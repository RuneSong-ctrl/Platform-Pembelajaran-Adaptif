# ==============================================================================
# Git Ignore Configuration - EduAdapt Platform
# ==============================================================================

# Dependencies
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Production & Build outputs
dist/
*/dist/
build/
*/build/
out/
*/out/
.next/
*/.next/

# Testing & Coverage
coverage/
*/coverage/
*.lcov
.nyc_output/

# Environment files (Keep .env.example safe)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.env.*
!.env.example
!*.env.example

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# TypeScript cache
*.tsbuildinfo
next-env.d.ts

# IDE & Editor configs
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swo

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# Temporary files & Caches
.turbo
.vercel
tmp/
temp/
*.pem
.eslintcache
